# ==============================================================================
# VN Mobiles - Environment Configuration Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database & Auth (Required)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# 2. Gmail SMTP Mail Gateway (Required for OTP & Verification Emails)
# ------------------------------------------------------------------------------
# Your full Gmail address
GMAIL_USER=your-email@gmail.com

# 16-character Google App Password (Generated in Google Account > Security > 2-Step Verification > App Passwords)
# Spaces and quotes are automatically sanitized by the backend.
GMAIL_APP_PASSWORD=your-16-char-app-password

# Optional Custom Sender / Reply-To headers:
# EMAIL_FROM="VN Mobiles" <your-email@gmail.com>
# EMAIL_REPLY_TO=your-support-email@gmail.com

# ------------------------------------------------------------------------------
# 3. Application Public Domain (Required for Email Verification & Reset Links)
# ------------------------------------------------------------------------------
# Production: e.g. https://vnmobiles.vercel.app or https://vnmobiles.in
# Development: http://localhost:3000
NEXT_PUBLIC_APP_URL=https://vnmobiles.vercel.app

# ------------------------------------------------------------------------------
# 4. Security & Sessions (Optional, defaults to GMAIL_APP_PASSWORD fallback if unset)
# ------------------------------------------------------------------------------
SESSION_SECRET=your-random-32-byte-hex-secret
