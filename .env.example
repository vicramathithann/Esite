# ==============================================================================
# VN Mobiles - Environment Configuration
# ==============================================================================
# Add these variables in Vercel Dashboard for BOTH Production AND Preview environments:
# Vercel Project Settings > Environment Variables

# 1. Gmail SMTP (Sender email & 16-char App Password from Google Account Security)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# 2. Supabase Configuration (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 3. Application Public URL (no trailing slash)
NEXT_PUBLIC_APP_URL=https://vnmobiles.vercel.app

# 4. Optional Debug Key (for /api/debug-email?key=...)
DEBUG_KEY=vn_debug_2026
